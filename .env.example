# Copy to .env (the server auto-reads process.env). The CMS works without this
# using a local fallback planner, but a key unlocks full natural-language editing.
#
#   ANTHROPIC_API_KEY=sk-ant-...
#
# Optional: pin a model (defaults to claude-sonnet-4-6 — fast + cheap, ideal here)
#   CMS_MODEL=claude-sonnet-4-6
#
# Optional: change the port (default 4321)
#   PORT=4321
